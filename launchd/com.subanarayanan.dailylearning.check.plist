    launchctl load ~/Library/LaunchAgents/com.subanarayanan.dailylearning.check.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.subanarayanan.dailylearning.check</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/subanarayanan/dev/test-automation-learning/scripts/check_completion.sh</string>
    </array>

    <key>StartCalendarInterval</key>
